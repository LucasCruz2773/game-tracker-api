# Application
NODE_ENV=development
PORT=3000

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=gametrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gametrack
POSTGRES_PORT=5432

# Must match the POSTGRES_* values above
DATABASE_URL="postgresql://gametrack:change-me@localhost:5432/gametrack?schema=public"

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Session length (7 days)
JWT_EXPIRES_IN_SECONDS=604800

# RAWG game catalog (free key at https://rawg.io/apidocs)
RAWG_API_KEY=your-rawg-api-key
# Optional; defaults to https://api.rawg.io/api (the e2e suite points it at a fake server)
# RAWG_BASE_URL=https://api.rawg.io/api

# Google sign-in: OAuth client of type "Web application" in Google Cloud Console.
# GOOGLE_CALLBACK_URL must be listed there as an authorized redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Where the browser is sent after signing in
FRONTEND_URL=http://localhost:5173