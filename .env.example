# Application
NODE_ENV=development
PORT=3000

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=gametrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gametrack
POSTGRES_PORT=5432

# Must match the POSTGRES_* values above
DATABASE_URL="postgresql://gametrack:change-me@localhost:5432/gametrack?schema=public"

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Session length (7 days)
JWT_EXPIRES_IN_SECONDS=604800
